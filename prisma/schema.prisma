datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// ==========================================
// FS-003: Company Management (Company Registry)
// ==========================================

enum CompanyStatus {
  active
  archived
}

enum CompanySize {
  micro
  small
  medium
  large
  unknown
}

model Company {
  id                 String        @id @default(uuid())
  /// Public tracking code used in routes (e.g. CO-1007). Unique when set.
  code               String?       @unique
  name               String
  alternativeNames   String[]      @default([])
  organizationNumber String?       @unique
  vatNumber          String?
  website            String?
  industry           String?
  size               CompanySize   @default(unknown)
  /// Multi-select company categories (display labels). Legacy enum values are normalized on read.
  types              String[]      @default(["Prospect"])
  /// Optional singular legacy field — prefer `types`. Kept for backward compatibility.
  companyType        String?
  status             CompanyStatus @default(active)

  ownerId         String?
  parentCompanyId String?
  parentCompany   Company?  @relation("CompanyHierarchy", fields: [parentCompanyId], references: [id], onDelete: SetNull)
  childCompanies  Company[] @relation("CompanyHierarchy")

  addressLine1 String?
  addressLine2 String?
  postalCode   String?
  city         String?
  stateRegion  String?
  country      String?
  countryCode  String?
  continent    String?

  emails       Json[] @default([]) // Array of { address, type, isPrimary }
  phoneNumbers Json[] @default([]) // Array of { number, type, isPrimary }

  contacts      Contact[]
  opportunities Opportunity[]
  notes         CompanyNote[]
  meetings      MeetingRecord[]
  decisions     DecisionJournal[]
  complianceAudits DocumentComplianceAudit[]
  executionProjects Project[]

  // FS-010 Growth & Expansion Intelligence
  healthRecords    AccountHealthRecord[]
  expansionSignals ExpansionSignal[]

  // FS-011 Autonomous Workflow Engine
  workflowExecutions WorkflowExecution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([code])
  @@index([organizationNumber])
  @@map("company_registry")
}

model CompanyNote {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  authorId  String
  content   String
  createdAt DateTime @default(now())

  @@map("company_notes")
}

/// Organizational Decision Journal — captured decisions from meetings, emails, notes.
model DecisionJournal {
  id              String   @id @default(uuid())
  companyId       String?
  company         Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  opportunityId   String?
  opportunity     Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  decisionText    String
  rationale       String?
  stakeholderName String?
  /// Technical | Commercial | Legal | Strategic | Other
  category        String
  confidenceScore Float    @default(0.5)
  sourceSnippet   String?
  createdAt       DateTime @default(now())
  scopeChanges    ProjectScopeChange[]

  @@index([companyId])
  @@index([opportunityId])
  @@index([createdAt])
  @@index([category])
  @@map("decision_journal")
}

// ==========================================
// FS-002: Contact Management (Contact Registry)
// ==========================================

enum ContactStatus {
  active
  archived
}

model Contact {
  id                     String        @id @default(uuid())
  firstName              String?
  lastName               String?
  fullName               String?
  jobTitle               String?
  preferredContactMethod String?
  linkedInUrl            String?
  buyingRole             String? // ECONOMIC_BUYER | CHAMPION | … or display labels
  sentiment              String?
  influenceLevel         String?
  /// Buying-center relationship strength (1–100). Optional.
  relationshipScore      Int?
  reportsToId            String?
  reportsTo              Contact?      @relation("OrgHierarchy", fields: [reportsToId], references: [id], onDelete: SetNull)
  directReports          Contact[]     @relation("OrgHierarchy")
  city                   String?
  country                String?
  streetAddress          String?
  postalCode             String?
  stateRegion            String?
  countryCode            String?
  continent              String?
  timezone               String?
  isTimezoneOverridden   Boolean       @default(false)
  engagementCadence      String?
  backgroundNotes        String?
  preferredLanguage      String?
  status                 ContactStatus @default(active)
  personalNotes          String?

  m365GraphId     String? @unique
  m365ImmutableId String? @unique

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  ownerId   String?

  emails       Json[] @default([]) // Array of { address, type, isPrimary }
  phoneNumbers Json[] @default([]) // Array of { number, type, isPrimary }

  // Directed Graph Connections (FS-004)
  sourceRelationships Relationship[] @relation("SourceContact")
  targetRelationships Relationship[] @relation("TargetContact")

  // Intelligence Relations (FS-006 & FS-007)
  influenceProfiles    StakeholderInfluenceProfile[]
  decisionMakerProfiles DecisionMakerProfile[]

  // FS-008 Meeting Intelligence
  meetingParticipants MeetingParticipantRecord[]

  // FS-009 Email & Interaction Intelligence
  emailMessages EmailMessageRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fullName])
  @@index([companyId])
  @@index([reportsToId])
  @@index([buyingRole])
  @@map("contact_registry")
}

// ==========================================
// FS-004: Relationship Intelligence
// ==========================================

enum RelationshipStatus {
  suggested
  confirmed
  active
  archived
}

enum RelationshipType {
  reports_to
  manages
  colleague
  advisor
  consultant
  supplier
  customer
  partner
  investor
  decision_influencer
  technical_influencer
  other
}

model Relationship {
  id                 String             @id @default(uuid())
  sourceContactId    String
  sourceContact      Contact            @relation("SourceContact", fields: [sourceContactId], references: [id], onDelete: Cascade)
  targetContactId    String
  targetContact      Contact            @relation("TargetContact", fields: [targetContactId], references: [id], onDelete: Cascade)
  relationshipType   RelationshipType
  relationshipStatus RelationshipStatus @default(suggested)
  statusReason       String?
  sourceType         String             @default("user_created") // user_created | smartassist_suggested | meeting_intelligence etc.

  strengthScore   Int?    @default(0)  // System-computed (0-100)
  confidenceScore Int?    @default(50) // System-computed (0-100)
  ownerId         String?
  notes           String?

  aiSummary      String?
  aiInsights     String[]                  @default([])
  lastAnalyzedAt DateTime?

  interactions RelationshipInteraction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceContactId, targetContactId, relationshipType])
  @@map("relationship_registry")
}

model RelationshipInteraction {
  id              String       @id @default(uuid())
  relationshipId  String
  relationship    Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  type            String       // meeting | call | email | introduction | note
  interactionDate DateTime
  summary         String?
  createdBy       String
  createdAt       DateTime     @default(now())

  @@map("relationship_interactions")
}

// ==========================================
// FS-001 & FS-005: Opportunity Workspace
// ==========================================

enum OpportunityStatus {
  open
  on_hold
  closed_won
  closed_lost
  archived
}

enum OpportunityStage {
  prospecting
  qualification
  discovery
  proposal
  negotiation
  commitment
  closed_won
  closed_lost
}

model Opportunity {
  id                String            @id @default(uuid())
  name              String
  companyId         String
  company           Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  ownerId           String
  stage             OpportunityStage  @default(prospecting)
  status            OpportunityStatus @default(open)
  value             Float?
  currency          String?           @default("USD")
  probability       Int?              @default(10)
  expectedCloseDate DateTime?
  description       String?
  nextStep          String?

  // FS-001 Stakeholder Roster stored as normalized relations or atomic JSON array
  team     Json[]               @default([]) // Array of { contactId: string, projectRole: string }
  insights OpportunityInsight[]
  decisions DecisionJournal[]

  // FS-006 & FS-007 Intelligence Relations
  influenceProfiles    StakeholderInfluenceProfile[]
  decisionMakerProfiles DecisionMakerProfile[]

  // FS-008 Meeting Intelligence
  meetings MeetingRecord[]

  // FS-009 Email & Interaction Intelligence
  emailMessages EmailMessageRecord[]

  // FS-009 / SmartDocs — M365 email attachments
  documents DocumentRecord[]
  complianceAudits DocumentComplianceAudit[]

  // FS-010 Growth & Expansion Intelligence
  expansionSignals ExpansionSignal[]

  // FS-011 Autonomous Workflow Engine
  workflowExecutions WorkflowExecution[]

  // Execution Intelligence — Stage-Gate projects
  executionProjects Project[]

  // SharePoint Online — opportunity document folder (single source of truth)
  sharepointFolderId  String?
  sharepointFolderUrl String?
  sharepointFolderPath String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([ownerId])
  @@index([stage])
  @@map("opportunity_registry")
}

model OpportunityInsight {
  id              String      @id @default(uuid())
  opportunityId   String
  opportunity     Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  type            String      // stakeholder_risk | relationship_gap | activity_stagnation | next_best_action
  observation     String
  reasoning       String
  recommendation  String
  expectedOutcome String?
  confidence      Int?
  createdAt       DateTime    @default(now())

  @@map("opportunity_insights")
}

// ==========================================
// FS-006: Influence Mapping
// ==========================================

enum InfluenceLevel {
  high
  medium
  low
  unknown
}

enum SentimentStance {
  champion
  positive
  neutral
  blocker
  unknown
}

model StakeholderInfluenceProfile {
  id             String          @id @default(uuid())
  opportunityId  String
  opportunity    Opportunity     @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  influenceLevel InfluenceLevel  @default(unknown)
  stance         SentimentStance @default(unknown)
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([opportunityId, contactId])
  @@map("stakeholder_influence_profiles")
}

// ==========================================
// FS-007: Decision Maker Intelligence
// ==========================================

enum AuthorityClass {
  economic_buyer
  technical_decision_maker
  commercial_decision_maker
  executive_sponsor
}

enum VerificationState {
  known
  assumed_unconfirmed
  unknown
}

model DecisionMakerProfile {
  id                String            @id @default(uuid())
  opportunityId     String
  opportunity       Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  contactId         String
  contact           Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  authorityClass    AuthorityClass
  verificationState VerificationState @default(unknown)
  signOffThreshold  Float?
  verifiedByUserId  String?
  verifiedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([opportunityId, contactId, authorityClass])
  @@map("decision_maker_profiles")
}

// ==========================================
// FS-008: Meeting Intelligence
// ==========================================

enum MeetingProvider {
  m365_graph
  google_workspace
  manual
}

enum SyncStatus {
  pending_review
  processed
  ignored
}

enum CommitmentState {
  proposed
  confirmed
  completed
  dismissed
}

enum MeetingResponseStatus {
  accepted
  declined
  tentative
  none
}

model MeetingRecord {
  id              String          @id @default(uuid())
  externalEventId String // M365 iCalUId or Event ID
  provider        MeetingProvider @default(m365_graph)
  subject         String
  startTime       DateTime
  endTime         DateTime
  location        String?
  webLink         String?
  organizerEmail  String
  aiSummary       String?
  syncStatus      SyncStatus      @default(pending_review)

  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  companyId     String?
  company       Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)

  participants MeetingParticipantRecord[]
  commitments  MeetingCommitmentRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, externalEventId])
  @@index([opportunityId])
  @@index([companyId])
  @@index([startTime])
  @@index([syncStatus])
  @@map("meeting_records")
}

model MeetingParticipantRecord {
  id             String                @id @default(uuid())
  meetingId      String
  meeting        MeetingRecord         @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  email          String
  name           String?
  contactId      String?
  contact        Contact?              @relation(fields: [contactId], references: [id], onDelete: SetNull)
  companyId      String?
  isExternal     Boolean               @default(true)
  responseStatus MeetingResponseStatus @default(none)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([meetingId, email])
  @@index([contactId])
  @@index([email])
  @@map("meeting_participant_records")
}

model MeetingCommitmentRecord {
  id                String          @id @default(uuid())
  meetingId         String
  meeting           MeetingRecord   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  description       String
  ownerEmail        String
  dueDate           DateTime?
  status            CommitmentState @default(proposed)
  confirmedByUserId String?
  confirmedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([meetingId])
  @@index([status])
  @@index([ownerEmail])
  @@map("meeting_commitment_records")
}

// ==========================================
// FS-009: Email & Interaction Intelligence
// ==========================================

enum SentimentGrade {
  positive
  neutral
  cautious
  negative
}

model EmailMessageRecord {
  id                String         @id @default(uuid())
  externalMessageId String         @unique
  conversationId    String
  opportunityId     String?
  opportunity       Opportunity?   @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  contactId         String?
  contact           Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  subject           String
  bodyPreview       String?
  senderEmail       String
  recipientEmails   String[]
  sentAt            DateTime
  sentiment         SentimentGrade @default(neutral)
  isOutbound        Boolean        @default(false)
  m365CategoryName  String?
  isDeletedInSource Boolean        @default(false)
  deletedAtInSource DateTime?
  createdAt         DateTime       @default(now())

  documents DocumentRecord[]

  @@index([conversationId])
  @@index([opportunityId])
  @@index([contactId])
  @@index([sentAt])
  @@index([senderEmail])
  @@index([isDeletedInSource])
  @@map("email_message_records")
}

/// SmartDocs / commercial file ingested from M365 email (Gap 4).
model DocumentRecord {
  id                   String   @id @default(uuid())
  name                 String
  mimeType             String?
  sizeBytes            Int?
  source               String   @default("m365_email") // m365_email | upload | manual
  externalAttachmentId String?
  contentBase64        String?  // Optional preview/download payload (seed / small files)

  opportunityId  String?
  opportunity    Opportunity?       @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  emailMessageId String?
  emailMessage   EmailMessageRecord? @relation(fields: [emailMessageId], references: [id], onDelete: Cascade)
  complianceAudits DocumentComplianceAudit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([emailMessageId, externalAttachmentId])
  @@index([opportunityId])
  @@index([emailMessageId])
  @@index([source])
  @@map("document_records")
}

/// SmartDocs Contract & Compliance Audit log (clause-level review).
model DocumentComplianceAudit {
  id               String   @id @default(uuid())
  smartDocId       String?
  documentRecordId String?
  documentRecord   DocumentRecord? @relation(fields: [documentRecordId], references: [id], onDelete: SetNull)
  opportunityId    String?
  opportunity      Opportunity?    @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  companyId        String?
  company          Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  documentType     String?
  overallRiskScore String
  /// Full audit payload: checklist, redFlags, remediations, summary
  findings         Json
  rawTextHash      String?
  sourceSnippet    String?
  createdAt        DateTime @default(now())

  @@index([smartDocId])
  @@index([documentRecordId])
  @@index([opportunityId])
  @@index([companyId])
  @@index([overallRiskScore])
  @@index([createdAt])
  @@map("document_compliance_audits")
}

// ==========================================
// M365 & Platform Integration Registry
// ==========================================

enum IntegrationProvider {
  m365_graph
  google_workspace
  hubspot
  salesforce
}

model ExternalIntegration {
  id               String              @id @default(uuid())
  provider         IntegrationProvider @default(m365_graph)
  tenantId         String?             // Microsoft Entra ID (Azure AD) Tenant ID
  userObjectId     String?             // M365 User Object ID
  accessToken      String?             // Encrypted OAuth Access Token (AES-256-GCM)
  refreshToken     String?             // Encrypted OAuth Refresh Token (AES-256-GCM)
  tokenExpiresAt   DateTime?
  deltaSyncToken   String?             // M365 Graph Delta Sync Token for incremental sync

  status           String              @default("active") // active | revoked | error
  lastSyncedAt     DateTime?

  webhookSubscriptions WebhookSubscription[]

  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@map("external_integrations")
}

/// Graph change-notification subscriptions (mail / calendar) — renewed by cron (Gap 1).
model WebhookSubscription {
  id                     String              @id @default(uuid())
  integrationId          String
  integration            ExternalIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  externalSubscriptionId String              @unique
  resource               String // e.g. "/me/mailFolders('Inbox')/messages", "/me/events"
  expiresAt              DateTime
  clientState            String
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([integrationId])
  @@index([expiresAt])
  @@map("webhook_subscriptions")
}

// ==========================================
// FS-010: Growth & Expansion Intelligence
// ==========================================

enum SignalType {
  upsell
  cross_sell
  renewal_risk
  churn_risk
}

enum SignalStatus {
  detected
  reviewing
  actioned
  dismissed
}

model AccountHealthRecord {
  id              String   @id @default(uuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  healthScore     Int
  engagementScore Int
  sentimentScore  Int
  calculatedAt    DateTime @default(now())

  @@index([companyId])
  @@index([calculatedAt])
  @@index([healthScore])
  @@map("account_health_records")
}

model ExpansionSignal {
  id              String       @id @default(uuid())
  companyId       String
  company         Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunityId   String?
  opportunity     Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  type            SignalType
  status          SignalStatus @default(detected)
  title           String
  observation     String
  reasoning       String
  recommendation  String
  expectedOutcome String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([companyId])
  @@index([opportunityId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("expansion_signals")
}

// ==========================================
// FS-011: Autonomous Workflow Engine
// ==========================================

enum WorkflowStatus {
  active
  paused
  archived
}

enum ExecutionStatus {
  pending_approval
  approved
  executed
  dismissed
  failed
}

model WorkflowRule {
  id          String         @id @default(uuid())
  name        String
  triggerType String // expansion_signal_detected | email_sentiment_drop | meeting_commitment_confirmed
  conditions  Json?
  status      WorkflowStatus @default(active)
  createdAt   DateTime       @default(now())

  executions WorkflowExecution[]

  @@index([triggerType])
  @@index([status])
  @@map("workflow_rules")
}

model WorkflowExecution {
  id            String          @id @default(uuid())
  ruleId        String
  rule          WorkflowRule    @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  opportunityId String?
  opportunity   Opportunity?    @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  companyId     String?
  company       Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  actionType    String // create_task | generate_outlook_draft | update_stage
  payload       Json
  status        ExecutionStatus @default(pending_approval)
  executedAt    DateTime?
  createdAt     DateTime        @default(now())

  @@index([ruleId])
  @@index([opportunityId])
  @@index([companyId])
  @@index([status])
  @@index([createdAt])
  @@map("workflow_executions")
}



// ==========================================
// Execution Intelligence — Multi-Track Stage-Gate Projects
// ==========================================

enum ExecutionProjectType {
  TURNKEY_PLANT
  SINGLE_MACHINERY
  INTERNAL_RD
}

enum ProjectHealthStatus {
  ON_TRACK
  AT_RISK
  DELAYED
}

/// Stage-Gate execution project — linked to Company and optional Opportunity.
model Project {
  id            String                @id @default(cuid())
  title         String
  projectType   ExecutionProjectType
  currentStage  String
  /// Technology Readiness Level 1–9 (INTERNAL_RD only)
  trlLevel      Int?
  companyId     String
  company       Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunityId String?
  opportunity   Opportunity?          @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  healthStatus  ProjectHealthStatus   @default(ON_TRACK)
  milestones    ProjectMilestone[]
  qualityInspections QualityInspection[]
  scopeChanges  ProjectScopeChange[]
  commissioningLogs CommissioningLog[]
  rdExperimentLogs RdExperimentLog[]
  eciInstrumentTags EciInstrumentTag[]
  atexInterlocks AtexInterlock[]
  plcReleases PlcRelease[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([companyId])
  @@index([opportunityId])
  @@index([projectType])
  @@index([healthStatus])
  @@map("execution_projects")
}

model ProjectMilestone {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  stage       String
  isCompleted Boolean   @default(false)
  dueDate     DateTime?
  completedAt DateTime?
  sortOrder   Int       @default(0)
  /// Planned lead time for this stage (days)
  estimatedLeadDays Int?
  /// Whether this milestone sits on the critical path to COD
  isCriticalPath Boolean @default(false)
  vendorName  String?
  targetDeliveryDate DateTime?
  qualityInspections QualityInspection[]

  @@index([projectId])
  @@index([stage])
  @@index([isCriticalPath])
  @@map("execution_project_milestones")
}

enum QualityInspectionType {
  FAT_FACTORY_TEST
  SAT_SITE_TEST
  ISO_QUALITY_AUDIT
  SAFETY_CHECK
}

enum QualityInspectionStatus {
  PASSED
  FAILED_NCR
  PENDING_REMEDIATION
}

/// FAT/SAT & ISO 9001 quality gate inspections for Stage-Gate projects.
model QualityInspection {
  id               String                   @id @default(cuid())
  projectId        String
  project          Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId      String?
  milestone        ProjectMilestone?        @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  inspectionType   QualityInspectionType
  status           QualityInspectionStatus
  title            String
  ncrDescription   String?
  remediationPlan  String?
  inspectorName    String?
  signedOffAt      DateTime?
  createdAt        DateTime                 @default(now())

  @@index([projectId])
  @@index([milestoneId])
  @@index([inspectionType])
  @@index([status])
  @@map("quality_inspections")
}

enum ScopeChangeStatus {
  PROPOSED
  APPROVED
  REJECTED
}

/// Engineering Change Orders (ECO) — Technical Design Freeze & Scope Change log.
model ProjectScopeChange {
  id                 String            @id @default(cuid())
  projectId          String
  project            Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  decisionJournalId  String?
  decisionJournal    DecisionJournal?  @relation(fields: [decisionJournalId], references: [id], onDelete: SetNull)
  changeTitle        String
  /// CLIENT_REQUEST | INTERNAL_ENGINEERING | SITE_SAFETY | …
  requestedBy        String
  description        String
  costImpactEur      Float
  scheduleImpactDays Int
  status             ScopeChangeStatus @default(PROPOSED)
  approvedBy         String?
  createdAt          DateTime          @default(now())

  @@index([projectId])
  @@index([decisionJournalId])
  @@index([status])
  @@index([createdAt])
  @@map("project_scope_changes")
}

enum CommissioningPhase {
  COLD_COMMISSIONING
  HOT_COMMISSIONING
  SYNGAS_TESTING
  PERFORMANCE_RUN
}

/// Site commissioning & safety check-in logs for field execution.
model CommissioningLog {
  id                 String              @id @default(cuid())
  projectId          String
  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase              CommissioningPhase
  safetyCheckPassed  Boolean             @default(false)
  atexZoningVerified Boolean             @default(false)
  logTitle           String
  operationalNotes   String?
  issuesEncountered  String?
  loggedBy           String?
  createdAt          DateTime            @default(now())

  @@index([projectId])
  @@index([phase])
  @@index([createdAt])
  @@map("commissioning_logs")
}

enum IpFilingStatus {
  NONE
  PROVISIONAL_FILED
  PATENT_GRANTED
  TRADE_SECRET
}

/// Internal R&D experiment runs — TRL progression & organizational memory.
model RdExperimentLog {
  id                   String         @id @default(cuid())
  projectId            String
  project              Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  experimentTitle      String
  trlStage             Int
  feedstockType        String?
  reactorTempCelsius   Float?
  residenceTimeMinutes Float?
  yieldPercentage      Float?
  ipFilingStatus       IpFilingStatus @default(NONE)
  keyFindings          String
  loggedBy             String?
  createdAt            DateTime       @default(now())

  @@index([projectId])
  @@index([trlStage])
  @@index([createdAt])
  @@map("rd_experiment_logs")
}

enum EciInstrumentType {
  TEMPERATURE
  PRESSURE
  GAS_ANALYZER
  VALVE_ACTUATOR
  LEVEL_SENSOR
  FLOW_METER
  SAFETY_SWITCH
}

enum EciIoType {
  DIGITAL_INPUT
  DIGITAL_OUTPUT
  ANALOG_INPUT
  ANALOG_OUTPUT
  MODBUS_RS485
  PROFINET
}

/// P&ID / EC&I instrument tags for IO list & calibration traceability.
model EciInstrumentTag {
  id            String            @id @default(cuid())
  projectId     String
  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tagNumber     String
  description   String
  instrumentType EciInstrumentType
  ioType        EciIoType
  exRating      String?
  isCalibrated  Boolean           @default(false)
  loopChecked   Boolean           @default(false)
  locationZone  String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([projectId, tagNumber])
  @@index([projectId])
  @@index([instrumentType])
  @@index([isCalibrated])
  @@index([loopChecked])
  @@map("eci_instrument_tags")
}

enum AtexZone {
  ZONE_0
  ZONE_1
  ZONE_2
  SAFE_AREA
}

/// ATEX / ESD cause-effect interlocks for hot-gas safety readiness.
model AtexInterlock {
  id                String   @id @default(cuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  loopName          String
  atexZone          AtexZone
  causeDescription  String
  effectDescription String
  isDryTested       Boolean  @default(false)
  isWetTested       Boolean  @default(false)
  verifiedBy        String?
  verifiedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([projectId])
  @@index([atexZone])
  @@index([isDryTested])
  @@map("atex_interlocks")
}

/// PLC / SCADA software release & loop verification progress.
model PlcRelease {
  id                 String   @id @default(cuid())
  projectId          String
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  plcTargetName      String
  codeVersion        String
  backupChecksum     String?
  notes              String?
  totalLoopsCount    Int      @default(0)
  verifiedLoopsCount Int      @default(0)
  deployedBy         String?
  createdAt          DateTime @default(now())

  @@index([projectId])
  @@index([createdAt])
  @@map("plc_releases")
}

// ==========================================
// FS-013: Enterprise Security, RBAC & Audit Logging
// ==========================================

enum Role {
  ADMIN
  MANAGER
  REP
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  role      Role      @default(REP)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  auditLogs AuditLog[]

  @@index([role])
  @@map("users")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userEmail  String
  action     String
  entityType String
  entityId   String
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ==========================================
// FS-015: Real-Time Notifications & Team Collaboration
// ==========================================

enum NotificationType {
  INFO
  ALERT
  APPROVAL
  DEAL_WIN
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType
  read      Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([userId, read])
  @@index([createdAt])
  @@map("notifications")
}

