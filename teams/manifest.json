{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "version": "1.2.0",
  "id": "6f3c8b2a-9d4e-4a1c-b7e2-a1b2c3d4e5f7",
  "developer": {
    "name": "Standard Bio",
    "websiteUrl": "https://sb-crm-seven.vercel.app",
    "privacyUrl": "https://sb-crm-seven.vercel.app",
    "termsOfUseUrl": "https://sb-crm-seven.vercel.app"
  },
  "name": {
    "short": "SmartCRM",
    "full": "SmartCRM for Teams"
  },
  "description": {
    "short": "Focus, briefing, account workspace, assign & notes",
    "full": "FS-018 complete v1: Daily Focus, Meeting Briefing, Account Workspace, message Assign, and post-meeting notes — without CRM iframes."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#E85D04",
  "staticTabs": [
    {
      "entityId": "smartcrm.dailyFocus",
      "name": "Daily Focus",
      "contentUrl": "https://sb-crm-seven.vercel.app/teams/daily-focus",
      "websiteUrl": "https://sb-crm-seven.vercel.app/teams/daily-focus",
      "scopes": ["personal"]
    },
    {
      "entityId": "smartcrm.assignMessage",
      "name": "Assign",
      "contentUrl": "https://sb-crm-seven.vercel.app/teams/assign-message",
      "websiteUrl": "https://sb-crm-seven.vercel.app/teams/assign-message",
      "scopes": ["personal"]
    },
    {
      "entityId": "smartcrm.postMeeting",
      "name": "Post-meeting",
      "contentUrl": "https://sb-crm-seven.vercel.app/teams/post-meeting",
      "websiteUrl": "https://sb-crm-seven.vercel.app/teams/post-meeting",
      "scopes": ["personal"]
    }
  ],
  "configurableTabs": [
    {
      "configurationUrl": "https://sb-crm-seven.vercel.app/teams/meeting-briefing/config",
      "canUpdateConfiguration": false,
      "scopes": ["groupchat", "team"],
      "context": ["meetingSidePanel", "meetingStage"]
    },
    {
      "configurationUrl": "https://sb-crm-seven.vercel.app/teams/account-workspace/config",
      "canUpdateConfiguration": true,
      "scopes": ["team", "groupchat"],
      "context": ["channelTab", "privateChatTab"]
    }
  ],
  "bots": [
    {
      "botId": "REPLACE_WITH_AZURE_AD_CLIENT_ID",
      "scopes": ["personal", "team", "groupchat"],
      "supportsFiles": false,
      "isNotificationOnly": false
    }
  ],
  "composeExtensions": [
    {
      "botId": "REPLACE_WITH_AZURE_AD_CLIENT_ID",
      "commands": [
        {
          "id": "assignMessage",
          "type": "action",
          "title": "Assign to SmartCRM",
          "description": "Link this message to a company, project, or opportunity",
          "context": ["message"],
          "fetchTask": true
        },
        {
          "id": "postMeeting",
          "type": "action",
          "title": "Post-meeting notes",
          "description": "Paste transcript and propose commitments (FS-014)",
          "context": ["message", "commandBox"],
          "fetchTask": true
        }
      ]
    }
  ],
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": [
    "sb-crm-seven.vercel.app",
    "crm.standard.bio",
    "login.microsoftonline.com"
  ],
  "webApplicationInfo": {
    "id": "REPLACE_WITH_AZURE_AD_CLIENT_ID",
    "resource": "api://sb-crm-seven.vercel.app/REPLACE_WITH_AZURE_AD_CLIENT_ID"
  }
}
