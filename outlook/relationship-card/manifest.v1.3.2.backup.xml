<?xml version="1.0" encoding="UTF-8"?>
<!-- SmartCRM for Outlook v1.3.1 — 2026-08-09 -->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp"
>
  <Id>6f3c8b2a-9d4e-4a1c-b7e2-a1b2c3d4e5f6</Id>
  <Version>1.3.2.0</Version>
  <ProviderName>SmartCRM</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="SmartCRM for Outlook" />
  <Description DefaultValue="Relationship intelligence, meeting briefings, and create contact, company, or opportunity from Outlook." />
  <IconUrl DefaultValue="https://sb-crm-seven.vercel.app/assets/icon-64.png" />
  <HighResolutionIconUrl DefaultValue="https://sb-crm-seven.vercel.app/assets/icon-128.png" />
  <SupportUrl DefaultValue="https://sb-crm-seven.vercel.app" />
  <AppDomains>
    <AppDomain>https://sb-crm-seven.vercel.app</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.5" />
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://sb-crm-seven.vercel.app/outlook-addin" />
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
    <Rule xsi:type="ItemIs" ItemType="Appointment" FormType="Read" />
  </Rule>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.5">
        <bt:Set Name="Mailbox" />
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="SmartCRM.Group">
                <Label resid="groupLabel" />
                <Control xsi:type="Button" id="btnRelCard">
                  <Label resid="relCardLabel" />
                  <Supertip>
                    <Title resid="relCardLabel" />
                    <Description resid="relCardTip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="icon16" />
                    <bt:Image size="32" resid="icon32" />
                    <bt:Image size="80" resid="icon80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="relCardUrl" />
                  </Action>
                </Control>
                <Control xsi:type="Button" id="btnBriefing">
                  <Label resid="briefLabel" />
                  <Supertip>
                    <Title resid="briefLabel" />
                    <Description resid="briefTip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="icon16" />
                    <bt:Image size="32" resid="icon32" />
                    <bt:Image size="80" resid="icon80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="briefUrl" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
          <ExtensionPoint xsi:type="AppointmentOrganizerCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="SmartCRM.ApptGroup">
                <Label resid="groupLabel" />
                <Control xsi:type="Button" id="btnBriefAppt">
                  <Label resid="briefLabel" />
                  <Supertip>
                    <Title resid="briefLabel" />
                    <Description resid="briefTip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="icon16" />
                    <bt:Image size="32" resid="icon32" />
                    <bt:Image size="80" resid="icon80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="briefUrl" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
          <ExtensionPoint xsi:type="AppointmentAttendeeCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="SmartCRM.AttendeeGroup">
                <Label resid="groupLabel" />
                <Control xsi:type="Button" id="btnBriefAttendee">
                  <Label resid="briefLabel" />
                  <Supertip>
                    <Title resid="briefLabel" />
                    <Description resid="briefTip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="icon16" />
                    <bt:Image size="32" resid="icon32" />
                    <bt:Image size="80" resid="icon80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="briefUrl" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="icon16" DefaultValue="https://sb-crm-seven.vercel.app/assets/icon-64.png" />
        <bt:Image id="icon32" DefaultValue="https://sb-crm-seven.vercel.app/assets/icon-64.png" />
        <bt:Image id="icon80" DefaultValue="https://sb-crm-seven.vercel.app/assets/icon-128.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="relCardUrl" DefaultValue="https://sb-crm-seven.vercel.app/outlook-addin" />
        <bt:Url id="briefUrl" DefaultValue="https://sb-crm-seven.vercel.app/outlook/meeting-briefing" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="groupLabel" DefaultValue="SmartCRM" />
        <bt:String id="relCardLabel" DefaultValue="Relationship Card" />
        <bt:String id="briefLabel" DefaultValue="Meeting Briefing" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="relCardTip" DefaultValue="Relationship health, next action, and create contact, company, or opportunity from this email." />
        <bt:String id="briefTip" DefaultValue="Prepare for your meeting in under 30 seconds — objective, risks, and action." />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
