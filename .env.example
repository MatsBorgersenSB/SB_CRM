# SmartCRM environment template — copy to `.env` and replace dummy values.
# Never commit real production secrets.

# PostgreSQL (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smartcrm?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/smartcrm?schema=public"

# AES-256 token encryption (required in production). Prefer 64 hex chars (32 bytes).
TOKEN_ENCRYPTION_SECRET="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Public app origin (OAuth redirects, Outlook add-in, deep links)
# Local: http://localhost:3000
# Production example: https://sb-crm-seven.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Protects /api/cron/* (Bearer or x-cron-secret)
CRON_SECRET="change-me-cron-secret"

# Comma-separated internal email domains (FS-009 privacy classification)
# Sign-in is NOT blocked by domain — any Azure AD user may authenticate.
# These domains receive elevated SmartCRM role (superuser).
INTERNAL_DOMAINS="standard.bio,standardbio.com,standardbio.no"

# Microsoft Entra ID / Azure AD SSO (NextAuth)
# Register redirect URI (Web platform, NOT SPA):
#   {NEXT_PUBLIC_APP_URL}/api/auth/callback/azure-ad
AZURE_AD_CLIENT_ID="stub-azure-client-id"
AZURE_AD_CLIENT_SECRET="stub-azure-client-secret"
# Prefer organizations|common|consumers here — GUIDs/domains break Auth.js issuer rewrite.
AZURE_AD_TENANT_ID="organizations"
# Optional explicit issuer (must use organizations|common|consumers in the path):
# AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/organizations/v2.0"
# Legacy aliases still supported:
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# NextAuth / Auth.js (required for SSO)
AUTH_SECRET="generate-a-long-random-secret"
# Required on Vercel — must match the public deployment origin (no trailing slash):
AUTH_URL="https://sb-crm-seven.vercel.app"
# NEXTAUTH_URL="https://sb-crm-seven.vercel.app"

# Legacy M365 Graph OAuth — redirect: {NEXT_PUBLIC_APP_URL}/api/auth/m365/callback
# M365_OAUTH_SCOPES=
# SHAREPOINT_TRANSPORT=local
# SHAREPOINT_SITE_ID=
# MICROSOFT_GRAPH_ACCESS_TOKEN=
# MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
# APP_VERSION=1.0.0
