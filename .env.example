# SmartCRM environment template — copy to `.env` and replace dummy values.
# Never commit real production secrets.

# PostgreSQL (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smartcrm?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/smartcrm?schema=public"

# Token encryption for M365 OAuth tokens at rest (required in production)
TOKEN_ENCRYPTION_SECRET="change-me-to-a-long-random-secret"

# Public app origin (OAuth redirects, Outlook deep links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Protects /api/cron/* (Bearer or x-cron-secret)
CRON_SECRET="change-me-cron-secret"

# Comma-separated internal email domains (FS-009 privacy classification)
INTERNAL_DOMAINS="example.com"

# Optional — M365 / Graph
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# M365_OAUTH_SCOPES=
# SHAREPOINT_TRANSPORT=local
# APP_VERSION=1.0.0
